# WaitMint.ai — public / client-safe only.
# NEVER put SUPABASE_SERVICE_ROLE_KEY or database passwords in this app.

# Canonical public site. On Vercel, set this to the live alias (currently
# https://waitmintai.vercel.app) until https://waitmint.ai DNS is attached.
# If unset on Vercel, the app uses VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Exchange API (backend-core). Production builds fail if this is localhost.
WAITMINT_API_URL=http://127.0.0.1:3001
NEXT_PUBLIC_WAITMINT_API_URL=http://127.0.0.1:3001

# Optional: Chrome Web Store listing
NEXT_PUBLIC_CHROME_EXTENSION_URL=https://chromewebstore.google.com/

# Optional: Google OAuth is configured in the Supabase dashboard, not here.
